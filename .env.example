# Environment Configuration for OpsPilot
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://opspilot:opspilot_secret@localhost:5432/opspilot_db?schema=public

# Redis & Cache / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_chars_long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Mailpit / SMTP
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@opspilot.local

# Default Seed Admin Credentials
ADMIN_EMAIL=admin@opspilot.local
ADMIN_PASSWORD=AdminPassword123!
